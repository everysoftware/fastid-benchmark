BENCHMARK_FASTID_GRANT_TYPE=client_credentials
BENCHMARK_FASTID_TOKEN_URL=http://localhost:8012/api/v1/token
BENCHMARK_FASTID_CLIENT_ID=fastid-client
BENCHMARK_FASTID_CLIENT_SECRET=fastid-secret
BENCHMARK_FASTID_SCOPE=""

BENCHMARK_KEYCLOAK_GRANT_TYPE=client_credentials
BENCHMARK_KEYCLOAK_TOKEN_URL=http://localhost:8087/realms/benchmark/protocol/openid-connect/token
BENCHMARK_KEYCLOAK_CLIENT_ID=keycloak-client
BENCHMARK_KEYCLOAK_CLIENT_SECRET=keycloak-secret
BENCHMARK_KEYCLOAK_SCOPE=""

BENCHMARK_AUTHENTIK_GRANT_TYPE=client_credentials
BENCHMARK_AUTHENTIK_TOKEN_URL=http://localhost:9000/application/o/token/
BENCHMARK_AUTHENTIK_CLIENT_ID=authentik-client
BENCHMARK_AUTHENTIK_CLIENT_SECRET=authentik-secret
BENCHMARK_AUTHENTIK_SCOPE=""

AUTHENTIK_WEB__THREADS=1
AUTHENTIK_WORKER__PROCESSES=1
AUTHENTIK_WORKER__THREADS=2
AUTHENTIK_POSTGRESQL__DISABLE_SERVER_SIDE_CURSORS=true
AUTHENTIK_POSTGRESQL__CONN_MAX_AGE=0

FASTID_DB_POOL_SIZE=100
FASTID_REDIS_POOL_SIZE=50
FASTID_GUNICORN_WORKER_CONNECTIONS=10000
FASTID_GUNICORN_MAX_REQUESTS=0


# Shared infrastructure secrets; generate random values before starting Compose.
PG_USER=postgres
PG_PASS=replace-with-random-database-password
REDIS_PASSWORD=replace-with-random-redis-password
AUTHENTIK_SECRET_KEY=replace-with-random-authentik-secret

# Token preflight uses only public keys; no token values are saved.
BENCHMARK_FASTID_JWKS_URL=http://localhost:8012/.well-known/jwks.json
BENCHMARK_FASTID_ISSUER=http://localhost:8012
BENCHMARK_KEYCLOAK_JWKS_URL=http://localhost:8087/realms/benchmark/protocol/openid-connect/certs
BENCHMARK_KEYCLOAK_ISSUER=http://localhost:8087/realms/benchmark
BENCHMARK_AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/benchmark/jwks/
BENCHMARK_AUTHENTIK_ISSUER=http://localhost:9000/application/o/benchmark/

# For fresh Authentik installations; existing installations can use AUTHENTIK_API_TOKEN.
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-random-bootstrap-token

# Dedicated benchmark client: use an explicitly provisioned service account.
BENCHMARK_AUTHENTIK_AUTH_METHOD=service_account
BENCHMARK_AUTHENTIK_SERVICE_ACCOUNT_USERNAME=benchmark-m2m
# Populated in local .env by make provision NAME=authentik; never commit a real app password.
BENCHMARK_AUTHENTIK_APP_PASSWORD=
# Access-token signing, distinct from client authentication.
BENCHMARK_KEYCLOAK_ACCESS_TOKEN_ALGORITHM=HS256

# Direct PostgreSQL is the common baseline for every IAM.
PG_FASTID_HOST=postgresql
PG_KEYCLOAK_HOST=postgresql
PG_AUTHENTIK_HOST=postgresql
